{
  "name": "dsh-notification",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishit130/dsh-notification.git"
  },
  "version": "0.1.1",
  "description": "Desktop, browser and webhook notifications when a DeepSeek Harness agent finishes a turn, hits an error, or needs approval.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "node --test tests/shared.test.ts tests/host.test.ts",
    "check:client": "node scripts/check-client.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.24.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notifications",
    "webhook"
  ]
}
